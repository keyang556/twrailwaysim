        "source": "規格 §7.1"
      },
      "repeat_last": {
        "keys": ["F2"],
        "label": "重複播報最近一則訊息",
        "category": "system",
        "source": "規格 §2.1 重要訊息需支援重複播報"
      },
      "pause_menu": {
        "keys": ["ESC"],
        "label": "開啟暫停選單（含離開遊戲）",
        "category": "system",
        "source": "規格 §7.1"
      }
    },
    "driver": {
